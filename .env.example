# Copy to .env and fill in. NEVER commit .env
APP_ENV=dev
TZ=Asia/Kolkata
DATABASE_URL=sqlite:///./data/civils.db
# Auth (single user). Generate JWT_SECRET with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
OWNER_USERNAME=naveen
# Hash made with: python -m app.auth.hash_password
OWNER_PASSWORD_HASH=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=60
# LLM (free tiers). Keys go here, never in chat or git.
GEMINI_API_KEY=
GROQ_API_KEY=
# Order of models to try, "provider:model" (checked 2026-09-20; run `python -m app.llm.check` to test)
LLM_CHAIN=gemini:gemini-3.5-flash-lite,gemini:gemini-3.8-flash,groq:openai/gpt-oss-20b
GEMINI_DAILY_REQUESTS=400
GROQ_DAILY_REQUESTS=1000
# Voice for audio briefs (change after listening to `python -m app.tts.samples`)
PIPER_VOICE=en_GB-alan-medium
YOUTUBE_API_KEY=
PAID_USAGE_ENABLED=false
# Push (later)
FCM_SERVICE_ACCOUNT_FILE=
# HTTPS (Caddy + DuckDNS)
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
