# Copy to .env and fill in. NEVER commit .env
APP_ENV=dev
TZ=Asia/Kolkata
DATABASE_URL=sqlite:///./data/civils.db
# Auth (single user). Generate JWT_SECRET with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
OWNER_USERNAME=naveen
# Hash made with: python -m app.auth.hash_password
OWNER_PASSWORD_HASH=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=60
# LLM (filled in later milestones)
GEMINI_API_KEY=
GROQ_API_KEY=
YOUTUBE_API_KEY=
PAID_USAGE_ENABLED=false
# Push (later)
FCM_SERVICE_ACCOUNT_FILE=
# HTTPS (Caddy + DuckDNS)
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
